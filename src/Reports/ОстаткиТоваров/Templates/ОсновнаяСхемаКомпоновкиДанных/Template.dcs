		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОстаткиТоваровОстаткиИОбороты.Регистратор КАК Регистратор,
	ОстаткиТоваровОстаткиИОбороты.ПериодСекунда КАК ПериодСекунда,
	ОстаткиТоваровОстаткиИОбороты.Номенклатура КАК Номенклатура,
	ОстаткиТоваровОстаткиИОбороты.Склад КАК Склад,
	ОстаткиТоваровОстаткиИОбороты.ЗаказКлиента КАК ЗаказКлиента,
	ОстаткиТоваровОстаткиИОбороты.СвободноНачальныйОстаток КАК СвободноНачальныйОстаток,
	ОстаткиТоваровОстаткиИОбороты.СвободноПриход КАК СвободноПриход,
	ОстаткиТоваровОстаткиИОбороты.СвободноРасход КАК СвободноРасход,
	ОстаткиТоваровОстаткиИОбороты.СвободноКонечныйОстаток КАК СвободноКонечныйОстаток,
	ОстаткиТоваровОстаткиИОбороты.РезервНачальныйОстаток КАК РезервНачальныйОстаток,
	ОстаткиТоваровОстаткиИОбороты.РезервПриход КАК РезервПриход,
	ОстаткиТоваровОстаткиИОбороты.РезервРасход КАК РезервРасход,
	ОстаткиТоваровОстаткиИОбороты.РезервКонечныйОстаток КАК РезервКонечныйОстаток
ИЗ
	РегистрНакопления.ОстаткиТоваров.ОстаткиИОбороты(, , Авто, , ) КАК ОстаткиТоваровОстаткиИОбороты</query>
	</dataSet>
